# PostgreSQL configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creditcheck?schema=public"
JWT_SECRET="change-me-super-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=4000
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"

# RecovaPro
RECOVAPRO_BASE_URL="https://api.recovapro.example.com"
RECOVAPRO_API_KEY="demo-key"
RECOVAPRO_TIMEOUT_MS=15000

# Consumer reporting
CONSUMER_REPORTING_BASE_URL="https://api.consumer-reporting.example.com"
CONSUMER_REPORTING_API_KEY="demo-key"
CONSUMER_REPORTING_TIMEOUT_MS=20000

# Income service
INCOME_SERVICE_BASE_URL="https://api.income-service.example.com"
INCOME_SERVICE_API_KEY="demo-key"
INCOME_SERVICE_TIMEOUT_MS=20000

# Redis / queue optional
REDIS_URL="redis://localhost:6379"

# App
APP_NAME="CreditCheck Admin"
SESSION_TIMEOUT_MINUTES=15
SESSION_LOCK_SECRET="change-me-lock-secret"
